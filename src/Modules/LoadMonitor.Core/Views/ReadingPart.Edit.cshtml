@model LoadMonitor.Core.ViewModels.ReadingPartViewModel

<div class="mb-3">
    <label asp-for="AssetContentItemId" class="form-label">Asset</label>
    <select asp-for="AssetContentItemId" asp-items="Model.Assets" class="form-select">
        <option value="">Choose an asset...</option>
    </select>
    <span asp-validation-for="AssetContentItemId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Timestamp" class="form-label">Timestamp</label>
    <input asp-for="Timestamp" type="datetime-local" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="PowerW" class="form-label">Power (W)</label>
    <input asp-for="PowerW" type="number" step="any" class="form-control" />
    <span asp-validation-for="PowerW" class="text-danger"></span>
</div>