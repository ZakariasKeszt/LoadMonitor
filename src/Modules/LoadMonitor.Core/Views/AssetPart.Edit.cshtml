@model LoadMonitor.Core.ViewModels.AssetPartViewModel

<div class="mb-3">
    <label asp-for="RatedPowerKw" class="form-label">Rated power (kW)</label>
    <input asp-for="RatedPowerKw" type="number" step="any" class="form-control" />
    <span asp-validation-for="RatedPowerKw" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="CurrentPowerW" class="form-label">Current power (W)</label>
    <input asp-for="CurrentPowerW" type="number" step="any" class="form-control" />
    <span asp-validation-for="CurrentPowerW" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="RunningHours" class="form-label">Running hours</label>
    <input asp-for="RunningHours" type="number" step="any" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="LoadProfile" class="form-label">Load profile</label>
    <select asp-for="LoadProfile" asp-items="Model.Profiles" class="form-select">
        <option value="">None</option>
    </select>
</div>