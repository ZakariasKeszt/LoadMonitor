@model LoadMonitor.Core.Models.AssetModel
@using System.Globalization

@{
    var inv = CultureInfo.InvariantCulture;
    var totalDrawKw = Model.Assets.Sum(a => a.CurrentPowerW) / 1000;
    var installedKw = Model.Assets.Sum(a => a.PowerKw);
    var runningCount = Model.Assets.Count(a => a.CurrentPowerW > 0);
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #0b0f14;
        --surface: #121821;
        --surface-2: #182130;
        --border: #222d3b;
        --text: #e6edf3;
        --muted: #8b98a5;
        --green: #22c55e;
        --amber: #f59e0b;
        --idle: #64748b;
        --radius: 20px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: radial-gradient(1200px 600px at 10% -10%, rgba(34, 197, 94, 0.08), transparent 60%), radial-gradient(900px 500px at 110% 10%, rgba(59, 130, 246, 0.07), transparent 60%), var(--bg);
        color: var(--text);
        font-family: Inter, system-ui, sans-serif;
        min-height: 100vh;
    }

    .lm {
        max-width: 1280px;
        margin: 0 auto;
        padding: 32px 24px 64px;
    }

    /* Top bar */
    .lm-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 32px;
    }

    .lm-title {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

        .lm-title span {
            color: var(--green);
        }

    .lm-live {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.875rem;
        color: var(--muted);
    }

    .lm-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
        animation: lm-pulse 2s infinite;
    }

    @@keyframes lm-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(34, 197, 94, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
        }
    }

    /* Summary row */
    .lm-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    .lm-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px 24px;
    }

    .lm-stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .lm-stat-value {
        margin-top: 8px;
        font-family: "JetBrains Mono", monospace;
        font-size: 2rem;
        font-weight: 700;
    }

        .lm-stat-value small {
            font-size: 1rem;
            color: var(--muted);
            margin-left: 4px;
        }

    /* Machine cards */
    .lm-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .lm-card {
        --accent: var(--idle);
        position: relative;
        display: flex;
        gap: 24px;
        padding: 24px;
        background: linear-gradient(180deg, var(--surface-2), var(--surface));
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        .lm-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 3px;
            background: var(--accent);
        }

        .lm-card:hover {
            transform: translateY(-3px);
            border-color: var(--accent);
        }

        .lm-card.is-running {
            --accent: var(--green);
        }

        .lm-card.is-high {
            --accent: var(--amber);
        }

    .lm-card-image {
        flex-shrink: 0;
        width: 140px;
        height: 140px;
        border-radius: 16px;
        background: #fff;
        padding: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .lm-card-image img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    .lm-card-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .lm-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .lm-card-name {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .lm-pill {
        flex-shrink: 0;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 15%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    }

    .lm-draw {
        margin-top: 12px;
        font-family: "JetBrains Mono", monospace;
        font-size: 2.25rem;
        font-weight: 700;
        line-height: 1;
    }

        .lm-draw small {
            font-size: 1rem;
            color: var(--muted);
            margin-left: 4px;
        }

    .lm-bar {
        margin-top: 14px;
        height: 8px;
        border-radius: 999px;
        background: #0e141c;
        border: 1px solid var(--border);
        overflow: hidden;
    }

    .lm-bar-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--accent);
        box-shadow: 0 0 12px var(--accent);
    }

    .lm-bar-label {
        margin-top: 6px;
        font-size: 0.75rem;
        color: var(--muted);
    }

    .lm-meta {
        margin-top: auto;
        padding-top: 16px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .lm-meta-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .lm-meta-value {
        margin-top: 2px;
        font-family: "JetBrains Mono", monospace;
        font-size: 1rem;
    }

    /* Responsive */
    @@media (max-width: 960px) {
        .lm-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .lm-summary {
            grid-template-columns: 1fr;
        }

        .lm-card {
            flex-direction: column;
        }

        .lm-card-image {
            width: 100%;
            height: 180px;
        }

        .lm-top {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .lm-dot {
            animation: none;
        }

        .lm-card {
            transition: none;
        }
    }
</style>

<div class="lm">
    <header class="lm-top">
        <h1 class="lm-title">Load <span>Monitor</span></h1>
        <div class="lm-live">
            <span class="lm-dot"></span>
            LIVE · @DateTime.Now.ToString("HH:mm")
        </div>
    </header>

    <section class="lm-summary">
        <div class="lm-stat">
            <div class="lm-stat-label">Current draw</div>
            <div class="lm-stat-value">@totalDrawKw.ToString("0.0", inv)<small>kW</small></div>
        </div>
        <div class="lm-stat">
            <div class="lm-stat-label">Installed power</div>
            <div class="lm-stat-value">@installedKw.ToString("0.#", inv)<small>kW</small></div>
        </div>
        <div class="lm-stat">
            <div class="lm-stat-label">Machines running</div>
            <div class="lm-stat-value">@runningCount<small>/ @Model.Assets.Count</small></div>
        </div>
    </section>

    <section class="lm-grid">
        @for (var i = 0; i < Model.Assets.Count; i++)
        {
            var asset = Model.Assets[i];
            var ratedW = asset.PowerKw * 1000;
            var load = ratedW > 0 ? Math.Min(asset.CurrentPowerW / ratedW * 100, 100) : 0;
            var state = asset.CurrentPowerW <= 0 ? "idle" : load >= 90 ? "high" : "running";
            var stateClass = state == "idle" ? "" : "is-" + state;
            var stateText = state == "idle" ? "Idle" : state == "high" ? "High load" : "Running";

            <a class="lm-card-link" href="~/assets/@i">
                <article class="lm-card @stateClass">
                    <div class="lm-card-image">
                        <img src="@Url.Content(asset.ImagePath)" alt="@asset.Name" />
                    </div>

                    <div class="lm-card-body">
                        <div class="lm-card-head">
                            <h2 class="lm-card-name">@asset.Name</h2>
                            <span class="lm-pill">@stateText</span>
                        </div>

                        <div class="lm-draw">
                            @asset.CurrentPowerW.ToString("N0", inv)<small>W</small>
                        </div>

                        <div class="lm-bar" role="progressbar" aria-label="Load"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@load.ToString("0", inv)">
                            <div class="lm-bar-fill" style="width: @load.ToString("0.#", inv)%"></div>
                        </div>
                        <div class="lm-bar-label">@load.ToString("0", inv)% of rated power</div>

                        <div class="lm-meta">
                            <div>
                                <div class="lm-meta-label">Rated power</div>
                                <div class="lm-meta-value">@asset.PowerKw.ToString("0.#", inv) kW</div>
                            </div>
                            <div>
                                <div class="lm-meta-label">Running time</div>
                                <div class="lm-meta-value">@asset.RunningHours.ToString("N0", inv) h</div>
                            </div>
                        </div>
                    </div>
                </article>
            </a>
        }
    </section>
</div>